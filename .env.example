# Copy this file to .env and fill in your values. Never commit .env.

# NSE Extranet API
NSE_ENVIRONMENT=LIVE          # LIVE or UAT
NSE_API_VERSION=2.0
NSE_MEMBER_CODE=
NSE_LOGIN_ID=
NSE_PASSWORD=
NSE_SECRET_KEY=               # Base64 AES-256 key from NSE

# Admin for schedules and folder lists.
# Leave empty and anyone can change schedules.
ADMIN_PASSWORD=

# Optional
# DATABASE_PATH=data/nse_downloader.db
# NSE_SCHEDULER=off           # run without the background scheduler
